	.data
str1: .asciiz "de quy can ngan xep de nho trang thai"
str2: .asciiz "|"
	.text
main:
	la $a0, str1
	jal reverse_words
	li $v0, 4
	la $a0, str2
	syscall
	li $v0, 4
	la $a0, str1
	syscall
	li $v0, 4
	la $a0, str2
	syscall
	li $v0, 10
	syscall
reverse_words:
	addi $sp, $sp, -12
	sw $ra, 8($sp)
	sw $s0, 4($sp)
	sw $s1, 0($sp)
	move $s0, $a0 #luu dia chi chuoi vao s0
	jal strlen
	beq $v0, $zero, rw_done #neu tu rong thi cung done
	add $a1, $a0, $v0
	addi $a1, $a1, -1
	jal rev_range
	move $s1, $s0
word_loop: #kiem tra ki tu dau tien cua mot tu
	lbu $t0, 0($s1)
	beq $t0, $zero, rw_done  #neu het tu thi done
	bne $t0, 32, word_start  #xem co phai dau cach khong
	addi $s1, $s1, 1 #bo qua dau cach
	j word_loop
word_start:
	move $t2, $s1
check: #kiem tra do dai cua tu
	lbu $t0, 0($t2)
	beq $t0, 32, word_end
	beq $t0, $zero, word_end
	addi $t2, $t2, 1
	j check
word_end:
	move $a0, $s1
	move $a1, $t2
	addi $a1, $a1, -1
	move $s1, $t2
	jal rev_range
	j word_loop	
rw_done:
	lw $s1, 0($sp)
	lw $s0, 4($sp)
	lw $ra, 8($sp)
	addi $sp, $sp, 12
	jr $ra
strlen:
	li $v0, 0
loop:
	add  $t1, $a0, $v0
	lbu  $t0, 0($t1)
	beq  $t0, $zero, then
	addi $v0, $v0, 1
	j    loop
then:
	jr $ra
rev_range:
loop2:
	bge $a0, $a1, then2
	lbu $t0, 0($a0)
	lbu $t1, 0($a1)
	sb $t0, 0($a1)
	sb $t1, 0($a0)
	addi $a0, $a0, 1
	addi $a1, $a1, -1
	j loop2
then2:
	jr $ra
